{
  "manifest_version": 3,
  "name": "Deny Everything",
  "version": "0.1.0",
  "description": "Answers cookie and tracking banners with a complete no: every consent switch, every legitimate-interest switch, every vendor.",
  "author": "SmallyBoii",
  "browser_specific_settings": {
    "gecko": {
      "id": "deny-everything@smallyboii",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["src/background.js"]
  },
  "action": {
    "default_title": "Deny Everything",
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/content/text.js",
        "src/content/dom.js",
        "src/content/rules.js",
        "src/content/engine.js",
        "src/content/bootstrap.js"
      ]
    }
  ]
}
